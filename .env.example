# ============ 模型 ============
# 在 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash：快、便宜（默认）
# deepseek-v4-pro：最新旗舰，推理模型，更准但慢 2~3 倍、费用更高
DEEPSEEK_MODEL=deepseek-flash
TEMPERATURE=0.7

# 允许模型调用 web_search 联网（必应 + 抓取网页正文）
ENABLE_WEB_SEARCH=true
MAX_TOKENS=400

# ============ 机器人身份 ============
# 机器人微信昵称（可多个，逗号分隔）。留空则自动从登录账号读取。
BOT_NAMES=
# 追加到系统提示词里的群规，例如：本群禁止讨论政治
EXTRA_SYSTEM_PROMPT=

# ============ 触发规则 ============
# at     = 只有 @机器人 才回复（推荐，最像真人）
# prefix = 以指定前缀开头才回复，前缀写完整命令词，例如 TRIGGER_PREFIX=/ask
# all    = 群里所有文本都回复（会很吵，仅测试用）
TRIGGER_MODE=at
TRIGGER_PREFIX=/
REPLY_IN_PRIVATE=true

# 只在这些群里工作（群名称或 roomid，逗号分隔）。留空 = 所有被拉进的群
ALLOWED_ROOMS=
# 永不回复的群（优先级高于 ALLOWED_ROOMS）
BLOCKED_ROOMS=
# 允许执行 /reset 等管理命令的 wxid，逗号分隔。留空 = 所有人都可以
ADMIN_WXIDS=

# ============ 上下文与记忆 ============
CONTEXT_MESSAGES=6
SUMMARY_TRIGGER=40
SUMMARY_KEEP=12
SUMMARY_MAX_CHARS=400

# ============ 防刷（降低风控命中率） ============
COOLDOWN_SECONDS=1
MAX_REPLIES_PER_MINUTE=20
MAX_REPLY_CHARS=1800

# ============ 存储与日志 ============
DB_PATH=data/bot.db
LOG_LEVEL=INFO
LOG_FILE=

# ============ 部署 ============
# embedded = 网关+核心同一进程（本机最简）；core = 只跑 API（Docker）；gateway = 只跑微信网关
MODE=embedded
CORE_URL=http://127.0.0.1:8000
CORE_HOST=0.0.0.0
CORE_PORT=8000
# 网关与核心之间的共享密钥，分机器部署时务必设置
GATEWAY_TOKEN=

# wcferry RPC 端口，默认 10086
WCF_PORT=10086
# wcferry 调试日志
WCF_DEBUG=false